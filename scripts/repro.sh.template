#!/usr/bin/env bash
# Canonical, project-specific reproduction template.
#
# This template consumes immutable software capsules at runs/<run-id>. It never
# follows a mutable selection link, rewrites a sealed run, or creates another
# result root. Fill every FILL marker with commands from the target repository.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNS_DIR="${RUNS_DIR:-$REPO_ROOT/runs}"
FIGURES_DIR="${FIGURES_DIR:-$REPO_ROOT/figures}"
TABLES_DIR="${TABLES_DIR:-$REPO_ROOT/tables}"
cd "$REPO_ROOT"

echo "[1/5] Load the pinned environment"
# FILL: activate the repository's locked environment without installing loose ranges.
:

echo "[2/5] Validate canonical software-run inputs"
shopt -s nullglob
run_dirs=("$RUNS_DIR"/*)
if [ "${#run_dirs[@]}" -eq 0 ]; then
    echo "No canonical run capsules found under $RUNS_DIR" >&2
    exit 2
fi
for run_dir in "${run_dirs[@]}"; do
    for required in run.json config.yaml train.csv best.pth; do
        [ -f "$run_dir/$required" ] || { echo "Missing $run_dir/$required" >&2; exit 2; }
    done
    [ ! -e "$run_dir/latest.pth" ] || { echo "Mutable latest.pth is forbidden in $run_dir" >&2; exit 2; }
    test_dirs=("$run_dir"/test/*)
    [ "${#test_dirs[@]}" -gt 0 ] || { echo "No declared test under $run_dir/test" >&2; exit 2; }
    for test_dir in "${test_dirs[@]}"; do
        [ -f "$test_dir/metrics.json" ] || { echo "Missing $test_dir/metrics.json" >&2; exit 2; }
        [ -f "$test_dir/results.parquet" ] || { echo "Missing $test_dir/results.parquet" >&2; exit 2; }
        [ -d "$test_dir/vis" ] || { echo "Missing mandatory $test_dir/vis" >&2; exit 2; }
    done
done
# FILL: run the repository's canonical exact-roster/schema validator here.
:

echo "[3/5] Independently reproduce or verify metrics"
# FILL: evaluate each runs/<run-id>/best.pth with its config.yaml into a fresh
# temporary verification directory, then compare against every declared
# test/<test-id>/{metrics.json,results.parquet}. Never overwrite the capsule.
:

echo "[4/5] Rebuild flat table and figure workshops"
# FILL: run each tables/<table-id>/build.py and figures/<figure-id>/build.py,
# then verify its table.json or figure.json and final-output hashes.
for workshop in "$TABLES_DIR"/* "$FIGURES_DIR"/*; do
    [ -d "$workshop" ] || continue
    [ -f "$workshop/build.py" ] && (cd "$workshop" && python build.py)
done

echo "[5/5] Reconcile claims and render QA"
# FILL: run project claim/evidence reconciliation plus parse, render, and
# editability checks. A zero exit is required before reporting reproduction.
:

echo "Canonical runs verified; derived workshops rebuilt."
